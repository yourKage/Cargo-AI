{
  "manifest_version": 3,
  "name": "One.dat HTML Sender",
  "version": "1.0",
  "description": "Captures and sends the entire HTML body to a local Flask server.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://one.dat.com/search-loads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send Load Data",
    "default_popup": "popup.html"
  }
}